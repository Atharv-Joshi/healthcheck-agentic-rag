# Copy to .env. Real environment variables override this file.
DATABASE_URL=postgresql+psycopg2://localhost:5432/healthcheck_qa
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
RATE_LIMIT=10/minute
LOG_LEVEL=INFO
AGENT_IMPL=raw   # raw | langchain
REFORMULATE_QUERIES=true
VERIFY_ANSWERS=false   # stretch: LLM citation check (+1 call per docs answer)
